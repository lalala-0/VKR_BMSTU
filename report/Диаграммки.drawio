  <diagram id="fr2_dvvBgaLgH3Rt_1eu" name="Разделение альбедо и затенения">
    <mxGraphModel dx="1277" dy="922" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
