        <mxCell id="XN83BCP6SjKEthX4mZBh-11" value="Нормализация затенения&lt;div&gt;shading_norm = (shading - p_low) / (p_high - p_low)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" parent="1" vertex="1">
