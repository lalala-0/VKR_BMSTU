        <mxCell id="GQkgss4pl0lj0VOZN5GX-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=16;" parent="1" source="XN83BCP6SjKEthX4mZBh-2" target="XN83BCP6SjKEthX4mZBh-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-2" value="Усиления деталей&lt;div&gt;log_image = log1p(img)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="100" y="209" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=16;" parent="1" source="XN83BCP6SjKEthX4mZBh-3" target="XN83BCP6SjKEthX4mZBh-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-3" value="Вычисление коэффициента фильтра Гаусса&lt;div&gt;sigma =&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;max(img.shape) * 0.02&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="100" y="290" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=16;" parent="1" source="XN83BCP6SjKEthX4mZBh-4" target="XN83BCP6SjKEthX4mZBh-6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-4" value="Применение фильтра Гаусса illumination = gauss_filter&lt;div&gt;(log_image, sigma)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="100" y="371" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=16;" parent="1" source="XN83BCP6SjKEthX4mZBh-6" target="XN83BCP6SjKEthX4mZBh-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-6" value="Вычитание освещения&lt;div&gt;&amp;nbsp;log_albedo = log_image - illumination&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="100" y="466" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=16;" parent="1" target="XN83BCP6SjKEthX4mZBh-9" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="219.94736842105272" y="597" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-7" value="Восстановление альбедо&lt;div&gt;&amp;nbsp;albedo = np.exp(log_albedo) - 1.0&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="100" y="548" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=16;" parent="1" source="XN83BCP6SjKEthX4mZBh-9" target="XN83BCP6SjKEthX4mZBh-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-9" value="Нормализация альбедо&lt;div&gt;albedo_norm = (albedo - p_low) / (p_high - p_low)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="100" y="630" width="240" height="69" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=16;" parent="1" source="XN83BCP6SjKEthX4mZBh-10" target="XN83BCP6SjKEthX4mZBh-11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-10" value="Вычисление затенения&lt;div&gt;shading = image / albedo&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="100" y="720" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=16;" parent="1" source="XN83BCP6SjKEthX4mZBh-11" target="GQkgss4pl0lj0VOZN5GX-3" edge="1">
