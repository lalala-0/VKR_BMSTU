  <diagram id="fr2_dvvBgaLgH3Rt_1eu" name="Разделение альбедо и затенения">
    <mxGraphModel dx="1404" dy="1031" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="GQkgss4pl0lj0VOZN5GX-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;" edge="1" parent="1" source="XN83BCP6SjKEthX4mZBh-2" target="XN83BCP6SjKEthX4mZBh-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-2" value="Усиления деталей&lt;div&gt;log_image = log1p(image)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="219" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;" edge="1" parent="1" source="XN83BCP6SjKEthX4mZBh-3" target="XN83BCP6SjKEthX4mZBh-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-3" value="Вычисление коэффициента фильтраГаусса&lt;div&gt;sigma =&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;max(image.shape) * 0.02&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="306" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;" edge="1" parent="1" source="XN83BCP6SjKEthX4mZBh-4" target="XN83BCP6SjKEthX4mZBh-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-4" value="Применение фильтра Гаусса illumination = gaussian_filter&lt;div&gt;(log_image, sigma)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="395" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;" edge="1" parent="1" source="XN83BCP6SjKEthX4mZBh-6" target="XN83BCP6SjKEthX4mZBh-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-6" value="Вычитание освещения&lt;div&gt;&amp;nbsp;log_albedo = log_image - illumination&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="487" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;" edge="1" parent="1" source="XN83BCP6SjKEthX4mZBh-7" target="XN83BCP6SjKEthX4mZBh-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-7" value="Восстановление альбедо&lt;div&gt;&amp;nbsp;albedo = np.exp(log_albedo) - 1.0&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="578" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;" edge="1" parent="1" source="XN83BCP6SjKEthX4mZBh-9" target="XN83BCP6SjKEthX4mZBh-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-9" value="Нормализация альбедо&lt;div&gt;albedo_norm = (albedo - p_low) / (p_high - p_low)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="671" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;" edge="1" parent="1" source="XN83BCP6SjKEthX4mZBh-10" target="XN83BCP6SjKEthX4mZBh-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-10" value="Вычисление затенения&lt;div&gt;shading = image / albedo&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="764" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GQkgss4pl0lj0VOZN5GX-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;" edge="1" parent="1" source="XN83BCP6SjKEthX4mZBh-11" target="GQkgss4pl0lj0VOZN5GX-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-11" value="Нормализация затенения&lt;div&gt;shading_norm = (shading - p_low) / (p_high - p_low)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="100" y="858" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-14" value="" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;pointerEvents=1;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="301" y="111" width="50" height="100" as="geometry" />
        </mxCell>
        <mxCell id="XN83BCP6SjKEthX4mZBh-15" value="Разделение альбедо и затенения&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Вход&lt;/b&gt;:&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- image - изображение&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;-&amp;nbsp;lighting_params - словарь параметров освещения&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Выход&lt;/b&gt;:&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;shading - карта теней&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
