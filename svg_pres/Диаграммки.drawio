        <mxCell id="jA2-eil40FW85yP_fseC-4" value="Расчет коэффициента масштабирования градиентов&amp;nbsp;&lt;div&gt;alpha = 0.2 / (brightness_std + 0.05)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" parent="1" vertex="1">
